{
  "name": "@mailbutler/sentry-lambda-proxy-transport",
  "version": "3.0.0",
  "description": "Drop-in replacement for Sentry's default HTTP transport to send events via AWS Lambda proxy instead",
  "main": "dist/index.js",
  "module": "esm/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*",
    "esm/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mailbutler/sentry-lambda-proxy-transport.git"
  },
  "author": "Fabian Jäger",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Mailbutler/sentry-lambda-proxy-transport/issues"
  },
  "homepage": "https://github.com/Mailbutler/sentry-lambda-proxy-transport#readme",
  "scripts": {
    "build": "run-p build:es5 build:esm",
    "build:es5": "tsc -p tsconfig.build.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:watch": "run-p build:watch:es5 build:watch:esm",
    "build:watch:es5": "tsc -p tsconfig.build.json -w --preserveWatchOutput",
    "build:watch:esm": "tsc -p tsconfig.esm.json -w --preserveWatchOutput",
    "clean": "rimraf dist coverage esm",
    "link:yarn": "yarn link",
    "lint": "run-s lint:prettier lint:tslint",
    "lint:prettier": "prettier --check \"{src,test}/**/*.ts\"",
    "lint:tslint": "tslint -t stylish -p .",
    "lint:tslint:json": "tslint --format json -p . | tee lint-results.json",
    "fix": "run-s fix:tslint fix:prettier",
    "fix:prettier": "prettier --write \"{src,test}/**/*.ts\"",
    "fix:tslint": "tslint --fix -t stylish -p .",
    "test": "jest",
    "test:jest": "jest",
    "test:watch": "jest --watch"
  },
  "jest": {
    "collectCoverage": true,
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "./tsconfig.json",
          "diagnostics": false
        }
      ]
    },
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ]
  },
  "devDependencies": {
    "@sentry/core": "^11.4.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^18",
    "jest": "^29.6.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.14",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^5.4.3"
  },
  "dependencies": {
    "@mailbutler/lambda-http-proxy": "^1.1.2",
    "tslib": "^2.6.2"
  },
  "peerDependencies": {
    "@sentry/core": "^11.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
